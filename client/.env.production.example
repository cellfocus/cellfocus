# =============================================================================
# CellFocus Client Production Configuration (.env.production)
# Target Host: Hostinger VPS / Static SPA
# =============================================================================

# When deployed behind Nginx on the same domain (cellfocus.pk), leave empty or omit
# so that relative requests (/api/...) are routed securely through HTTPS without CORS.
# If hosting frontend and backend on separate domains/subdomains, set full API URL:
# VITE_API_URL=https://cellfocus.pk
VITE_API_URL=

