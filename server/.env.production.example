# =============================================================================
# CellFocus Production Environment Configuration (.env.production)
# Target Host: Hostinger VPS / Cloud Server
# Instructions: Copy this file to `server/.env` on your production server.
# =============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000
SITE_URL=https://cellfocus.pk

# Strict CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://cellfocus.pk,https://www.cellfocus.pk

# Database Configuration (MongoDB Atlas or Local MongoDB on Hostinger)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cellfocus?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cellfocus

# Master Administrative Security & Authentication
# Generate a strong 64-character random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8
ADMIN_PASSCODE=cellfocus2026_SecureAdmin#99

# Optional: Restrict Admin Portal by IP (Leave blank to permit all authenticated IPs)
ALLOWED_ADMIN_IPS=

# Cloudinary CDN Image Management Credentials
CLOUDINARY_CLOUD_NAME=ros12wj5
CLOUDINARY_API_KEY=483987842624792
CLOUDINARY_API_SECRET=kz4wPvcKx57JbKnZQW9xhkXGXjU
CLOUDINARY_URL=cloudinary://483987842624792:kz4wPvcKx57JbKnZQW9xhkXGXjU@ros12wj5

